@page "/settings/personalization"
@using Microsoft.AspNetCore.Components.Authorization
@using IT.WebServices.Authentication
@using Admin.Components.Common.Selects.ImagePicker

<AuthorizeView Roles="@RoleAbilities.ROLE_IS_ADMIN_OR_OWNER">
    <Authorized>
        <div class="space-y-6">
            <SectionHeader Title="Personalization" />

            <Card Class="max-w-3xl">
                <CardHeader Class="flex flex-row items-center justify-between">
                    <div>
                        <CardTitle>Site Identity</CardTitle>
                        <CardDescription>Branding and appearance defaults for your site.</CardDescription>
                    </div>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="StartEdit" Disabled="IsEditing">
                        <LucideIcon Name="pencil" class="h-4 w-4 mr-1.5" />
                        Edit
                    </Button>
                </CardHeader>
                <CardContent Class="space-y-6">
                    <Field>
                        <FieldLabel For="title">Title</FieldLabel>
                        <FieldContent>
                            <Input Id="title" Type="InputType.Text" Placeholder="Your Site Title" @bind-Value="_personalizationPublicSettings.Title" Disabled="!IsEditing" />
                        </FieldContent>
                    </Field>
                    <Field>
                        <FieldLabel For="meta-desc">Meta Description</FieldLabel>
                        <FieldContent>
                            <Input Id="meta-desc" Type="InputType.Text" Placeholder="SEO Description For Your Site" @bind-Value="_personalizationPublicSettings.MetaDescription" Disabled="!IsEditing" />
                        </FieldContent>
                    </Field>
                    <Field>
                        <FieldLabel>Default To Dark Mode</FieldLabel>
                        <FieldContent>
                            <Switch @bind-Checked="_personalizationPublicSettings.DefaultToDarkMode" Disabled="!IsEditing" />
                        </FieldContent>
                    </Field>
                    <ImagePickerField Label="Profile Image"
                                      HelperText="Default profile image shown for users who haven't set their own."
                                      @bind-SelectedAssetId="_personalizationPublicSettings.ProfileImageAssetId"
                                      Disabled="!IsEditing" />
                    <ImagePickerField Label="Header Image"
                                      HelperText="Icon shown in the navbar on IT.WebHost.App."
                                      @bind-SelectedAssetId="_personalizationPublicSettings.HeaderImageAssetId"
                                      Disabled="!IsEditing" />
                </CardContent>
            </Card>
        </div>

        <SaveChangesBar IsShown="IsEditing" OnDiscard="CancelEdit" OnSave="SaveSettingsAsync" />
    </Authorized>
</AuthorizeView>