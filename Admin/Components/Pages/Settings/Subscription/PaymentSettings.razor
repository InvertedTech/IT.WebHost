@page "/settings/subscription"
@using Admin.Components.Pages.Settings.Subscription.Jobs
@using IT.WebServices.Authentication
@using IT.WebServices.Clients.Settings
@using IT.WebServices.Fragments.Authorization
@using IT.WebServices.Fragments.Settings
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<AuthorizeView Roles="@(RoleAbilities.ROLE_IS_ADMIN_OR_OWNER)">
    <Authorized>
        <SettingsPageHeader Title="Subscription Settings" Description="Configure payment processing, subscription tiers, and processor credentials.">
            <Actions>
                <Button Variant="@(_isEditing ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Small" OnClick="ToggleEdit">
                    <LucideIcon Name="@(_isEditing ? "lock-open" : "lock")" class="h-4 w-4 mr-1.5" />
                    @(_isEditing ? "Editing" : "Edit")
                </Button>
            </Actions>
        </SettingsPageHeader>

        <SubscriptionTiersSection Public="_public" IsEditing="_isEditing"
                                   OnCreateTier="OnCreateTier"
                                   OnEditTier="OnEditTier"
                                   OnDeleteTier="OnDeleteTier" />

        <div class="settings-grid">
            <GeneralRulesCard Public="_public" IsEditing="_isEditing" />
            <PaymentProcessorsCard Public="_public" IsEditing="_isEditing" OnChange="StateHasChanged" />
        </div>

        <AuthorizeView Roles="@(RoleAbilities.ROLE_OWNER)" Context="ownerAuth">
            <Authorized>
                <div class="settings-section-gap">
                    <ProcessorCredentialsCard Public="_public" Owner="_owner" IsEditing="_isEditing" />
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="settings-section-gap">
            <JobsSection />
        </div>

        <SaveChangesBar IsShown="_isEditing" OnDiscard="CancelEdit" OnSave="HandleSave" />
    </Authorized>
</AuthorizeView>
