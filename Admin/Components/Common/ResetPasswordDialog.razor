@using IT.WebServices.Authentication
@using IT.WebServices.Fragments
@using IT.WebServices.Fragments.Authentication

<Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="OpenDialog">
    <LucideIcon Name="key-round" class="h-4 w-4 mr-1.5" />
    Reset Password
</Button>

<Dialog @bind-Open="isOpen">
    <DialogContent>
        <DialogHeader>
            <DialogTitle>Reset Password</DialogTitle>
            <DialogDescription>
                Reset the User's Password
            </DialogDescription>
        </DialogHeader>
        <Field>
            <FieldLabel>
                <div class="flex items-center justify-between w-full">
                    <span>New Password</span>
                </div>
            </FieldLabel>
            <FieldContent>
                <Input Id="password"
                       Type="InputType.Password"
                       @bind-Value="newPassword"
                       AriaInvalid="@(errors.Count > 0)"
                       @bind-Value:after="ClearErrors" />
            </FieldContent>
        </Field>
        <Field>
            <FieldLabel>
                <div class="flex items-center justify-between w-full">
                    <span>Confirm New Password</span>
                </div>
            </FieldLabel>
            <FieldContent>
                <Input Id="confirm-password"
                       Type="InputType.Password"
                       @bind-Value="confirmNewPassword"
                       AriaInvalid="@(errors.Count > 0)"
                       @bind-Value:after="ClearErrors" />
                <FieldError Errors="errors" />
            </FieldContent>
        </Field>
        <DialogFooter>
            <Button Variant="ButtonVariant.Outline" @onclick="CloseDialog" Disabled="isSaving">Cancel</Button>
            <Button @onclick="ResetUserPassword" Disabled="isSaving">Save</Button>
        </DialogFooter>
    </DialogContent>
</Dialog>

@code {
    [Inject] public UserInterface.UserInterfaceClient UserClient { get; set; } = null!;
    [Inject] public ONUserHelper UserHelper { get; set; } = null!;
    [Inject] public IToastService ToastService { get; set; } = null!;
    [Parameter] public string userId { get; set; } = null!;
    private string newPassword { get; set; } = string.Empty;
    private string confirmNewPassword { get; set; } = string.Empty;
    private bool isOpen { get; set; } = false;
    private bool isSaving { get; set; } = false;
    private List<string> errors { get; set; } = new List<string>();

    private async Task ResetUserPassword()
    {
        if (string.IsNullOrEmpty(newPassword))
        {
            errors = new List<string> { "Password cannot be empty." };
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            errors = new List<string> { "Passwords do not match." };
            return;
        }

        isSaving = true;

        var req = new ChangeOtherPasswordRequest
        {
            UserID = userId,
            NewPassword = newPassword
        };

        var res = await UserClient.ChangeOtherPasswordAsync(req, UserHelper.GetGrpcCallOptions());

        isSaving = false;

        if (res?.Error is null || res.Error.Reason == APIErrorReason.ErrorReasonNoError)
        {
            ToastService.Success("Password reset successfully.");
            CloseDialog();
        }
        else
        {
            var message = !string.IsNullOrEmpty(res.Error.Message)
                ? res.Error.Message
                : res.Error.Reason.ToString();

            errors = new List<string> { message };
            ToastService.Error(message);
        }
    }

    private void ClearErrors()
    {
        errors = new List<string>();
    }

    private void OpenDialog()
    {
        newPassword = string.Empty;
        confirmNewPassword = string.Empty;
        errors = new List<string>();
        isOpen = true;
    }

    private void CloseDialog()
    {
        isOpen = false;
    }
}
