@page "/login"
<form @onsubmit=OnLoginAsync>
    <Card Class="w-full max-w-sm">
        <CardHeader Class="space-y-1 pb-4">
            <div class="flex items-center justify-center mb-2">
                <div class="size-10 rounded-xl bg-foreground flex items-center justify-center">
                    <LucideIcon Name="layers" Size="18" Class="text-background" />
                </div>
            </div>
            <CardTitle Class="text-xl font-semibold text-center">Welcome back</CardTitle>
            <CardDescription Class="text-center">Sign in to your account to continue</CardDescription>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <Alert Variant="AlertVariant.Destructive">
                    <AlertTitle>Error</AlertTitle>
                    <AlertDescription>@errorMessage</AlertDescription>
                </Alert>
            }
        </CardHeader>
        <CardContent Class="space-y-4">
            <Field>
                <FieldLabel For="usernameOrEmail">Username Or Email</FieldLabel>
                <FieldContent>
                    <Input Id="usernameOrEmail"
                           Type="InputType.Text"
                           Placeholder="you@example.com"
                           @bind-Value="loginRequest.UserName"
                           @bind-Value:after="ClearValidation"
                           AriaInvalid="@(userNameErrors.Count > 0)" />
                    <FieldError Errors="userNameErrors" />
                </FieldContent>
            </Field>
            <Field>
                <FieldLabel>
                    <div class="flex items-center justify-between w-full">
                        <span>Password</span>
                        <a href="/forgot-password" class="text-xs text-muted-foreground hover:text-foreground transition-colors">
                            Forgot password?
                        </a>
                    </div>
                </FieldLabel>
                <FieldContent>
                    <Input Id="password"
                           Type="InputType.Password"
                           @bind-Value="loginRequest.Password"
                           @bind-Value:after="ClearValidation"
                           AriaInvalid="@(passwordErrors.Count > 0)" />
                    <FieldError Errors="passwordErrors" />
                </FieldContent>
            </Field>
            <Button Type="ButtonType.Submit" Class="w-full" Disabled="@(isSubmitting || !RendererInfo.IsInteractive)">
                @if (isSubmitting)
                {
                    <Spinner Size="SpinnerSize.Small" />
                    @("Submitting")
                }
                else
                {
                    @("Sign In")
                }
            </Button>
            <p class="text-center text-xs text-muted-foreground">
                Don't have an account?
                <a href="/signup" class="text-foreground font-medium hover:underline underline-offset-2">Sign up</a>
            </p>
        </CardContent>
    </Card>
</form>
