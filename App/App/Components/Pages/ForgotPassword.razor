@page "/forgot-password"
<Card Class="w-full max-w-sm">
    <CardHeader Class="space-y-1 pb-4">
     </CardHeader>
    @if (!showCompletedMessage)
    {
        <CardContent>
            <Field>
                <FieldLabel For="email">Email</FieldLabel>
                <FieldContent>
                    <Input Id="email" Type="InputType.Email" Placeholder="Enter your email" @bind-Value="email" />
                </FieldContent>
            </Field>
        </CardContent>
        <CardFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="Submit">Reset Password</Button>
        </CardFooter>
    } else
    {
        <CardContent>
            <p class="leading-relaxed">If you have an account with us, we will send you a link to reset your password. Check your spam folder as well if it does not arrive</p>
            <p class="leading-relaxed">You May Close This Window</p>
        </CardContent>
        <CardFooter>
            <Button Variant="ButtonVariant.Outline" OnClick="GoBack">Back to Login</Button>
        </CardFooter>
    }
</Card>