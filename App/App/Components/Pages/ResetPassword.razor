@page "/reset-password"
@using IT.WebServices.Fragments.Authentication

<form @onsubmit="OnResetPasswordAsync">
<Card>
    <CardHeader>
        <CardTitle>Reset Password</CardTitle>
        <CardDescription>Enter your new password below.</CardDescription>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Alert Variant="AlertVariant.Destructive">
                <AlertTitle>Error</AlertTitle>
                <AlertDescription>@errorMessage</AlertDescription>
            </Alert>
        }
        </CardHeader>
        @if (isCheckingToken)
        {
        <CardContent>
            <p class="leading-relaxed">Checking reset link...</p>
        </CardContent>
        }
        else if (!isTokenValid)
        {
        <CardFooter>
            <Button Type="ButtonType.Button"
                    Variant="ButtonVariant.Default"
                    OnClick="GoToLogin">
                Back to Login
            </Button>
        </CardFooter>
        }
        else if (!isSuccess)
        {
        <CardContent>
        <Field>
            <FieldLabel>
                <div class="flex items-center justify-between w-full">
                    <span>New Password</span>
                </div>
            </FieldLabel>
            <FieldContent>
                <Input Id="password"
                       Type="InputType.Password"
                       @bind-Value="newPassword"
                       @bind-Value:after="ClearValidation"
                       AriaInvalid="@(newPasswordErrors.Count > 0)" />
                <FieldError Errors="newPasswordErrors" />
            </FieldContent>
        </Field>
        <Field>
            <FieldLabel>
                <div class="flex items-center justify-between w-full">
                    <span>Confirm New Password</span>
                </div>
            </FieldLabel>
            <FieldContent>
                <Input Id="confirm-password"
                       Type="InputType.Password"
                       @bind-Value="confirmNewPassword"
                       @bind-Value:after="ClearValidation" />
            </FieldContent>
        </Field>
        </CardContent>
        <CardFooter>
            <Button Type="ButtonType.Submit"
                    Variant="ButtonVariant.Default"
                    Disabled="@(isLoading || !RendererInfo.IsInteractive)">
                @if (isLoading)
                {
                    <Spinner Size="SpinnerSize.Small" />
                    @("Submitting")
                }
                else
                {
                    @("Reset Password")
                }
            </Button>
        </CardFooter>
        }
        else
        {
        <CardContent>
            <p class="leading-relaxed">Your password has been reset successfully.</p>
        </CardContent>
        <CardFooter>
            <Button Type="ButtonType.Button"
                    Variant="ButtonVariant.Default"
                    OnClick="GoToLogin">
                Go to Login
            </Button>
        </CardFooter>
        }
</Card>
</form>
